@model PROG6212POE.Models.Login

<h2>Create User</h2>

<form asp-action="CreateUser" method="post">

    <label>Username</label>
    <input asp-for="Username" class="form-control" />
    <span asp-validation-for="Username" class="text-danger"></span>

    <label>Password</label>
    <input asp-for="Password" class="form-control" />
    <span asp-validation-for="Password" class="text-danger"></span>

    <label>Role</label>
    <select asp-for="Role" class="form-control" id="roleSelect">
        <option value="Lecturer">Lecturer</option>
        <option value="Coordinator">Coordinator</option>
        <option value="Manager">Manager</option>
        <option value="HR">HR</option>
    </select>

    <div id="lecturerFields">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />

        <label>Surname</label>
        <input asp-for="Surname" class="form-control" />

        <label>Email</label>
        <input asp-for="Email" class="form-control" />

        <label>Hourly Rate (R)</label>
        <input asp-for="HourlyRate" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Create User</button>
</form>

@section Scripts {
    <script>
        function toggleLecturerFields() {
            const role = document.getElementById("roleSelect").value;
            document.getElementById("lecturerFields").style.display =
                role === "Lecturer" ? "block" : "none";
        }

        document.getElementById("roleSelect").addEventListener("change", toggleLecturerFields);
        toggleLecturerFields();
    </script>
}
